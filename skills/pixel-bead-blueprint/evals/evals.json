{
  "skill": "pixel-bead-blueprint",
  "version": "1.4.0",
  "schema": "agent-skill-evals/1",
  "runner": "node evals/run-evals.cjs",
  "notes": "kind=cli 可机器判定；kind=manual 需人工或大模型在环判定（先问学员、参数理由等行为类断言）。fixtures 由 scripts/test/fixtures/fixtures.html 解包，首次运行自动提取。",
  "fixtures": {
    "mondrian": "scripts/test/fixtures/mondrian-1930-cii-original.jpg",
    "progressive": "scripts/test/fixtures/progressive-mondrian.jpg"
  },
  "cases": [
    {
      "id": "EVAL-A-001",
      "source": "cases.md 第一部分 FUNC-A-001 + 场景 1",
      "kind": "cli",
      "intent": "工作流 A：一张图 → 完整交付物（含终审图、迭代报告、辅导计划）",
      "command": ["scripts/run.js", "{{mondrian}}", "--grid", "64", "--teach", "--review-gate", "0", "--out", "{{tmp}}"],
      "expect": {
        "exitCode": 0,
        "files": [
          "blueprint.md", "blueprint.json", "blueprint.png", "blueprint-ascii.txt",
          "sheet.png", "compare.png", "review.png", "review.md", "refine.md", "coaching.md"
        ],
        "mdInclude": ["色号表", "采购清单"],
        "assertGrid": { "file": "blueprint.json", "shortSide": 64 },
        "reason": "FUNC-A-001 要求 9 件；加 --teach 后应为 10 件（coaching.md）"
      }
    },
    {
      "id": "EVAL-TEACH-001",
      "source": "cases.md FUNC-TEACH-001 + 场景 1",
      "kind": "cli",
      "reuse": "EVAL-A-001",
      "intent": "辅导计划落盘：coaching.md 必含难度评定 / 场次 / 校验点",
      "expect": {
        "files": ["coaching.md"],
        "mdIncludeIn": {
          "coaching.md": ["难度", "场次", "校验点"]
        }
      }
    },
    {
      "id": "EVAL-MATRIX-001",
      "source": "cases.md FUNC-MATRIX-001",
      "kind": "cli",
      "intent": "一条命令跑多方案 → 对照图 + 指标表，供 AI 选版",
      "command": ["scripts/run.js", "{{mondrian}}", "--grid", "24", "--compare-matrix", "--review-gate", "0", "--out", "{{tmp}}"],
      "expect": {
        "exitCode": 0,
        "files": ["compare-matrix.png", "matrix.md", "matrix.json"],
        "mdIncludeIn": { "matrix.md": ["复跑"] }
      }
    },
    {
      "id": "EVAL-FMT-001",
      "source": "cases.md 场景 5（progressive JPEG）",
      "kind": "cli",
      "intent": "格式兼容：progressive JPEG 自动转码不报错，正常出图",
      "command": ["scripts/run.js", "{{progressive}}", "--grid", "48", "--review-gate", "0", "--out", "{{tmp}}"],
      "expect": {
        "exitCode": 0,
        "files": ["blueprint.md", "sheet.png", "compare.png", "review.png"],
        "stdoutInclude": ["progressive"]
      }
    },
    {
      "id": "EVAL-SPLIT-001",
      "source": "cases.md 场景 2（超大图分块）",
      "kind": "cli",
      "intent": "分块索引 + 逐块按需出图：跨块行列号全局连续",
      "command": ["scripts/run.js", "{{mondrian}}", "--grid", "64", "--split", "16", "--review-gate", "0", "--out", "{{tmp}}"],
      "expect": {
        "exitCode": 0,
        "files": ["blocks-index.json", "sheet-blocks.md"],
        "jsonFields": {},
        "assertBlocks": { "blocksIndex": "blocks-index.json" }
      }
    },
    {
      "id": "EVAL-GATE-001",
      "source": "cases.md 场景 1 + 交付门禁（README 质量门禁 §3/§4）",
      "kind": "cli",
      "intent": "交付门禁双向：空判定表 exit 3，填完并签署 exit 0",
      "command": ["scripts/run.js", "{{mondrian}}", "--grid", "24", "--out", "{{tmp}}"],
      "expect": {
        "exitCode": 3,
        "stdoutInclude": ["REVIEW_UNFILLED"],
        "files": ["review.md"]
      },
      "then": {
        "fillReview": "{{tmp}}/review.md",
        "command": ["scripts/run.js", "--verify-review", "{{tmp}}"],
        "expect": { "exitCode": 0, "stdoutInclude": ["REVIEW_SIGNED"] }
      }
    },
    {
      "id": "EVAL-B-001",
      "source": "cases.md FUNC-B-001 + 场景 3",
      "kind": "manual",
      "intent": "库存闭环：--scan 成品照 → inventory.json → --limit-palette 只用手里的色号",
      "why": "需要一张真实成品照/色卡照作为输入（随包样张是名画翻拍，门禁会按设计拒绝），故列为人工验收",
      "steps": [
        "node scripts/run.js <成品照> --scan inventory.json",
        "node scripts/run.js <新照片> --inventory inventory.json --limit-palette --grid 64 --out out-b",
        "检查 blueprint.md 的「库存覆盖与缺色」段：--limit-palette 版缺色应为 0"
      ]
    },
    {
      "id": "EVAL-AGENT-001",
      "source": "cases.md 场景 1 / 场景 4（行为类）",
      "kind": "manual",
      "intent": "辅导环行为：先问学员再出图；参数决策必须给理由；反馈后按根因回调而不是随机换参",
      "why": "属于大模型在环行为断言，无法用 CLI 退出码判定；建议由评审用 cases.md 第一部分 FUNC-TEACH-001 的人工检查项逐条打勾",
      "checklist": [
        "任何参数决定之前，先问经验档位/单次时长/辨色/库存",
        "参数建议同时引用视觉观察与 --analyze 特征值，并说明为什么",
        "用户反馈「不像」时，先分根因（网格档 vs 行内错位）再动手",
        "讲解挑 2~3 条本图专属易错点，不整份 coaching.md 照念"
      ]
    }
  ]
}